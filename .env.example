# Optional: Formspree (or compatible JSON form endpoint) URL for direct email delivery.
# If left unset, the contact form cleanly uses a pre-filled mailto fallback with
# copy-to-clipboard assistance so messages are never silently discarded.
# Example: VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
VITE_FORMSPREE_ENDPOINT=

# Optional: Base path override for non-GitHub-Pages hosting.
# Defaults to /vinoththiru_portfolio/ for GitHub Pages.
# Set to / for Vercel or Netlify root deployments.
# VITE_BASE_PATH=/
